{
  "name": "makermind-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-06-13",
  "keep_vars": true,
  "vars": {
    "AI_MODEL": "deepseek-v4-pro"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "makermind-db",
      "database_id": "0b334b9b-9406-4e84-b21a-ede2e9d55b47"
    }
  ]
}
